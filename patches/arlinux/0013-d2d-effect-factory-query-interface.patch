From: ARLinux contributors
Subject: d2d1: Query the implementation interface returned by an effect factory.

An effect factory returns IUnknown, not necessarily the ID2D1EffectImpl
interface address. Native Windows queries ID2D1EffectImpl before Initialize.
Casting the identity pointer instead can dispatch to unrelated methods and
corrupt the effect context. Keep the factory reference until QueryInterface
has acquired the implementation reference, then release it on either result.

--- a/dlls/d2d1/effect.c
+++ b/dlls/d2d1/effect.c
@@ -3421,6 +3421,7 @@
     struct d2d_effect_context *effect_context;
     const struct d2d_effect_registration *reg;
     struct d2d_effect *object;
+    IUnknown *implementation;
     UINT32 input_count;
     WCHAR clsidW[39];
     HRESULT hr;
@@ -3466,7 +3467,7 @@
         return hr;
     }
 
-    if (FAILED(hr = reg->factory((IUnknown **)&object->impl)))
+    if (FAILED(hr = reg->factory(&implementation)))
     {
         WARN("Failed to create implementation object, hr %#lx.\n", hr);
         ID2D1Effect_Release(&object->ID2D1Effect_iface);
@@ -3474,6 +3475,15 @@
         return hr;
     }
 
+    hr = IUnknown_QueryInterface(implementation, &IID_ID2D1EffectImpl, (void **)&object->impl);
+    IUnknown_Release(implementation);
+    if (FAILED(hr))
+    {
+        WARN("Failed to query effect implementation, hr %#lx.\n", hr);
+        ID2D1Effect_Release(&object->ID2D1Effect_iface);
+        return hr;
+    }
+
     if (FAILED(hr = ID2D1EffectImpl_Initialize(object->impl, &effect_context->ID2D1EffectContext_iface,
             &object->graph->ID2D1TransformGraph_iface)))
     {
