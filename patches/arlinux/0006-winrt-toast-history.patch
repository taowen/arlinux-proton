+/* WinRT toast notification history.
+ *
+ * This library is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "private.h"
+#include "initguid.h"
+#define WIDL_using_Windows_UI_Notifications
+#include "windows.ui.notifications.h"
+
+/* Wine has no toast delivery backend. Its history is consequently empty;
+ * clearing that history is valid, but creating/delivering toasts is not yet
+ * implemented. Never return success with a NULL notification object. */
+static IActivationFactory factory;
+static IToastNotificationManagerStatics statics;
+static IToastNotificationManagerStatics2 statics2;
+static IToastNotificationHistory history;
+
+static HRESULT query( REFIID iid, void **out, BOOL is_history )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ))
+        *out = is_history ? (void *)&history : (void *)&factory;
+    else if (is_history && IsEqualGUID( iid, &IID_IToastNotificationHistory )) *out = &history;
+    else if (!is_history && IsEqualGUID( iid, &IID_IActivationFactory )) *out = &factory;
+    else if (!is_history && IsEqualGUID( iid, &IID_IToastNotificationManagerStatics )) *out = &statics;
+    else if (!is_history && IsEqualGUID( iid, &IID_IToastNotificationManagerStatics2 )) *out = &statics2;
+    else return E_NOINTERFACE;
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+#define INSPECTABLE(prefix,type,is_history) \
+static HRESULT WINAPI prefix##_QueryInterface(type *iface, REFIID iid, void **out) { return query(iid,out,is_history); } \
+static ULONG WINAPI prefix##_AddRef(type *iface) { return 2; } \
+static ULONG WINAPI prefix##_Release(type *iface) { return 1; } \
+static HRESULT WINAPI prefix##_GetIids(type *iface, ULONG *count, IID **iids) { if (!count || !iids) return E_POINTER; *count=0; *iids=NULL; return E_NOTIMPL; } \
+static HRESULT WINAPI prefix##_GetRuntimeClassName(type *iface, HSTRING *name) { const WCHAR *value=is_history ? L"Windows.UI.Notifications.ToastNotificationHistory" : L"Windows.UI.Notifications.ToastNotificationManager"; if (!name) return E_POINTER; return WindowsCreateString(value,wcslen(value),name); } \
+static HRESULT WINAPI prefix##_GetTrustLevel(type *iface, TrustLevel *level) { if (!level) return E_POINTER; *level=BaseTrust; return S_OK; }
+#define BASE(prefix) prefix##_QueryInterface, prefix##_AddRef, prefix##_Release, prefix##_GetIids, prefix##_GetRuntimeClassName, prefix##_GetTrustLevel
+
+INSPECTABLE(factory,IActivationFactory,FALSE)
+INSPECTABLE(statics,IToastNotificationManagerStatics,FALSE)
+INSPECTABLE(statics2,IToastNotificationManagerStatics2,FALSE)
+INSPECTABLE(history,IToastNotificationHistory,TRUE)
+
+static HRESULT WINAPI factory_ActivateInstance(IActivationFactory *iface, IInspectable **out)
+{ if (!out) return E_POINTER; *out=NULL; return E_NOTIMPL; }
+static HRESULT WINAPI statics_CreateToastNotifier(IToastNotificationManagerStatics *iface, IToastNotifier **out)
+{ if (!out) return E_POINTER; *out=NULL; return E_NOTIMPL; }
+static HRESULT WINAPI statics_CreateToastNotifierWithId(IToastNotificationManagerStatics *iface, HSTRING id, IToastNotifier **out)
+{ return statics_CreateToastNotifier(iface,out); }
+static HRESULT WINAPI statics_GetTemplateContent(IToastNotificationManagerStatics *iface, ToastTemplateType type, __x_ABI_CWindows_CData_CXml_CDom_CIXmlDocument **out)
+{ if (!out) return E_POINTER; *out=NULL; return E_NOTIMPL; }
+static HRESULT WINAPI statics2_get_History(IToastNotificationManagerStatics2 *iface, IToastNotificationHistory **out)
+{ if (!out) return E_POINTER; *out=&history; IToastNotificationHistory_AddRef(*out); return S_OK; }
+static HRESULT WINAPI history_RemoveGroup(IToastNotificationHistory *iface, HSTRING group) { return S_OK; }
+static HRESULT WINAPI history_RemoveGroupWithId(IToastNotificationHistory *iface, HSTRING group, HSTRING id) { return S_OK; }
+static HRESULT WINAPI history_RemoveGroupedTagWithId(IToastNotificationHistory *iface, HSTRING tag, HSTRING group, HSTRING id) { return S_OK; }
+static HRESULT WINAPI history_RemoveGroupedTag(IToastNotificationHistory *iface, HSTRING tag, HSTRING group) { return S_OK; }
+static HRESULT WINAPI history_Remove(IToastNotificationHistory *iface, HSTRING tag) { return S_OK; }
+static HRESULT WINAPI history_Clear(IToastNotificationHistory *iface) { return S_OK; }
+static HRESULT WINAPI history_ClearWithId(IToastNotificationHistory *iface, HSTRING id) { return S_OK; }
+
+static const IActivationFactoryVtbl factory_vtbl = { BASE(factory), factory_ActivateInstance };
+static const IToastNotificationManagerStaticsVtbl statics_vtbl = { BASE(statics), statics_CreateToastNotifier, statics_CreateToastNotifierWithId, statics_GetTemplateContent };
+static const IToastNotificationManagerStatics2Vtbl statics2_vtbl = { BASE(statics2), statics2_get_History };
+static const IToastNotificationHistoryVtbl history_vtbl = { BASE(history), history_RemoveGroup, history_RemoveGroupWithId, history_RemoveGroupedTagWithId, history_RemoveGroupedTag, history_Remove, history_Clear, history_ClearWithId };
+static IActivationFactory factory = { &factory_vtbl };
+static IToastNotificationManagerStatics statics = { &statics_vtbl };
+static IToastNotificationManagerStatics2 statics2 = { &statics2_vtbl };
+static IToastNotificationHistory history = { &history_vtbl };
+IActivationFactory *notifications_factory = &factory;
