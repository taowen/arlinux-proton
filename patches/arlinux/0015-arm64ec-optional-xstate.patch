Subject: [PATCH] ntdll: Handle absent AVX storage in ARM64EC context conversion

CONTEXT_XSTATE does not imply that the context contains AVX storage.
RtlLocateExtendedFeature can return NULL for a context without that feature.
Keep the zero-initialized upper registers when reading absent state, and do
not write an absent output feature. This prevents recursive access violations
while unwinding managed exceptions with a partial extended context.

diff --git a/dlls/ntdll/unwind.h b/dlls/ntdll/unwind.h
--- a/dlls/ntdll/unwind.h
+++ b/dlls/ntdll/unwind.h
@@ -176,7 +176,7 @@ static inline void context_x64_to_arm( ARM64_NT_CONTEXT *arm_ctx, const ARM64EC_NT_CONTEXT *ec_ctx )
     {
         CONTEXT_EX *ec_xctx = (CONTEXT_EX *)(ec_ctx + 1);
         YMMCONTEXT *ec_ymm = RtlLocateExtendedFeature( ec_xctx, XSTATE_AVX, NULL );
-        memcpy( arm_ctx->V + 16, ec_ymm, sizeof(*ec_ymm) );
+        if (ec_ymm) memcpy( arm_ctx->V + 16, ec_ymm, sizeof(*ec_ymm) );
     }
 }
 
@@ -233,7 +233,7 @@ static inline void context_arm_to_x64( ARM64EC_NT_CONTEXT *ec_ctx, const ARM64_NT_CONTEXT *arm_ctx )
     {
         CONTEXT_EX *ec_xctx = (CONTEXT_EX *)(ec_ctx + 1);
         YMMCONTEXT *ec_ymm = RtlLocateExtendedFeature( ec_xctx, XSTATE_AVX, NULL );
-        memcpy( ec_ymm, arm_ctx->V + 16, sizeof(*ec_ymm) );
+        if (ec_ymm) memcpy( ec_ymm, arm_ctx->V + 16, sizeof(*ec_ymm) );
     }
 }
 
