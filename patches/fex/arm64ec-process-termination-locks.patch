Subject: [PATCH] ARM64EC: drain code invalidation before terminating peer threads

NtTerminateProcess(NULL) terminates the other threads, but leaves the caller
alive to run DLL detach. A terminated compiler can otherwise leave the code
invalidation lock held, deadlocking VirtualFree during DLL detach.

Use the existing ThreadCreationMutex -> CodeInvalidationMutex order across
the termination syscall. This changes neither process exit nor DLL cleanup.

diff --git a/Source/Windows/ARM64EC/Module.cpp b/Source/Windows/ARM64EC/Module.cpp
--- a/Source/Windows/ARM64EC/Module.cpp
+++ b/Source/Windows/ARM64EC/Module.cpp
@@ -654,7 +654,22 @@ NTSTATUS ProcessInit() {
   return STATUS_SUCCESS;
 }
 
-void ProcessTerm(HANDLE Handle, BOOL After, NTSTATUS Status) {}
+void ProcessTerm(HANDLE Handle, BOOL After, NTSTATUS Status) {
+  // NtTerminateProcess(NULL) stops the other threads before DLL detach runs.
+  // Drain compilation/invalidation first, and keep those locks owned by the
+  // surviving thread across the syscall. Otherwise a terminated compiler can
+  // leave a shared lock held forever when DLL detach frees executable memory.
+  if (Handle || !CTX) {
+    return;
+  }
+  if (!After) {
+    ThreadCreationMutex.lock();
+    CTX->GetCodeInvalidationMutex().lock();
+  } else {
+    CTX->GetCodeInvalidationMutex().unlock();
+    ThreadCreationMutex.unlock();
+  }
+}
 
 class ScopedCallbackDisable {
 private:
